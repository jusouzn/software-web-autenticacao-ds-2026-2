      direction LR
      NG["Nginx<br/>servidor web / proxy reverso"] --- ST[/"Arquivos estáticos<br/>login.html, autenticacao.js, estilos.css"/]
    end
    subgraph C2["contêiner app – porta interna 8000"]
      direction LR
      UV["Uvicorn<br/>servidor de aplicação ASGI"] -- "interface ASGI" --> APP["Aplicação FastAPI<br/>Python 3.12"]
    end
    subgraph C3["contêiner db – porta interna 5432"]
      PG[("PostgreSQL 16<br/>tabela usuario")]
    end
  end
  B -- "1. consulta DNS (UDP 53)" --> DNS
  B -- "2. HTTPS (TCP 443, TLS 1.3)" --> C1
  C1 -- "3. HTTP/1.1 – somente /api/*" --> C2
  C2 -- "4. protocolo PostgreSQL – SQL parametrizado" --> C3
