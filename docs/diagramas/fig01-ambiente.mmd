flowchart TB
  subgraph CLI["Máquina do usuário"]
    direction LR
    U(["Usuário"]) --> B["Navegador Web<br/>motor HTML/CSS/JS, Fetch API, pilha TLS"]
  end
  DNS{{"Servidor DNS recursivo"}}
  subgraph SRV["Servidor: host Linux + Docker Engine (rede interna do Docker)"]
